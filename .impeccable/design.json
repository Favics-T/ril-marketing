      "css": ".ds-nav { padding:12px; background:var(--surface-strong,#182332); display:grid; gap:4px; font:500 13px/1.6 \"Open Sans\",system-ui,sans-serif; } .ds-nav a { display:flex; align-items:center; min-height:40px; padding:0 12px; color:var(--sidebar-foreground,#d7e0eb); text-decoration:none; border-radius:6px; } .ds-nav a[aria-current] { background:var(--surface-strong-selected,#314766); color:white; } .ds-nav a:hover { background:var(--sidebar-accent,#2b3b50); } .ds-nav a:focus-visible { outline:2px solid var(--sidebar-ring,#a9cfff); outline-offset:2px; }"
