      "html": "<button class=\"ds-primary\">Save changes</button>",
      "css": ".ds-primary { background:hsl(var(--primary,213 86% 39%)); color:white; border:0; border-radius:6px; min-height:40px; padding:8px 16px; font:600 14px/1.4 \"Open Sans\",system-ui,sans-serif; transition:background-color 150ms,scale 120ms; } .ds-primary:hover { opacity:.9; } .ds-primary:active { scale:.98; } .ds-primary:focus-visible { outline:2px solid hsl(var(--ring,213 86% 39%)); outline-offset:3px; } .ds-primary:disabled { opacity:.5; } @media(prefers-reduced-motion:reduce) { .ds-primary { transition:none; } .ds-primary:active { scale:1; } }"
    },
