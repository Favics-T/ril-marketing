# Supabase
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Protected cron trigger (use a long random secret in production)
CRON_SECRET=change-me-to-a-long-random-secret

# Public production origin used by tracked links and the daily email delivery worker.
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Required before saving provider credentials or sending email.
# Generate two independent random values (at least 32 characters) and keep them stable.
AI_CONFIG_SECRET=change-me-to-a-long-random-secret
EMAIL_UNSUBSCRIBE_SECRET=change-me-to-another-long-random-secret

# Encrypts stored AI provider API keys at rest (AES-256-GCM). Optional but
# recommended in production. Set a long random value; leaving it unset keeps
# keys in plaintext (legacy behavior). Rotating it makes existing stored keys
# unreadable — users just re-enter their key in Settings > AI settings.

# Optional LLM for richer drafts (template mode otherwise).
# Pick a provider and paste its key — or do it in Settings > AI settings.
# AI_PROVIDER=openai  # openai | anthropic | gemini
# AI_API_KEY=
# AI_MODEL=  # optional: one of the curated IDs in src/lib/ai/providers.ts

# Buffer can connect with an API key in Settings; no Buffer environment variables
# are needed for that flow. The optional values below enable OAuth sign-in instead.
# Buffer social publishing. Buffer's current API is GraphQL at api.buffer.com;
# the legacy REST API (api.bufferapp.com/1/) is retired on 1 February 2027.
# Register an OAuth client in Buffer under Settings > API and set its redirect
# URL to https://<your-domain>/api/integrations/buffer/callback
# BUFFER_CLIENT_ID is required only for OAuth. BUFFER_CLIENT_SECRET is only needed for a
# confidential client; a public client authenticates with PKCE alone.
# BUFFER_CLIENT_ID=
# BUFFER_CLIENT_SECRET=
